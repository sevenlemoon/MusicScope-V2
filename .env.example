# MusicScope V2 uses its own database and named Docker volume.
POSTGRES_DB=musicscope_v2
POSTGRES_USER=musicscope_v2
# The launcher generates a unique local password in ignored .env; do not set a shared default.
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# The launcher fills this from the generated local password.
DATABASE_URL=

API_HOST=127.0.0.1
API_PORT=8100
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
NEXT_PUBLIC_API_URL=http://localhost:8100
LOG_LEVEL=INFO

# Server-only AES-256-GCM key: URL-safe base64 for exactly 32 random bytes.
# Required before storing provider sessions. Never expose this as NEXT_PUBLIC_*.
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_VERSION=1

# R1 will select and configure the server-side NetEase API implementation.
NETEASE_API_BASE_URL=http://127.0.0.1:36531
NETEASE_REQUEST_TIMEOUT_SECONDS=10
NETEASE_PLAYLIST_PAGE_SIZE=50
NETEASE_SONG_BATCH_SIZE=200
NETEASE_SONG_CONCURRENCY=2
MUSICSCOPE_NETEASE_PORT=36531

# R4.1 local Studio processing. The audio worker has its own isolated environment.
AUDIO_STORAGE_DIR=storage/audio
SEPARATOR_MODEL=htdemucs
AUDIO_UPLOAD_MAX_BYTES=209715200
AUDIO_DURATION_MAX_SECONDS=900
AUDIO_STORAGE_QUOTA_BYTES=10737418240
AUDIO_WORKER_STALE_SECONDS=90
AUDIO_WORKER_POLL_SECONDS=1
# Leave empty for validated MPS/CUDA/CPU selection; use cpu for an explicit retry.
AUDIO_WORKER_DEVICE=

# R3 core concert provider. The API key remains backend-only.
CONCERT_PROVIDER=ticketmaster
TICKETMASTER_API_KEY=
TICKETMASTER_TIMEOUT_SECONDS=6
TICKETMASTER_SEARCH_PAGE_BUDGET=2
LIVE_CACHE_TTL_HOURS=6
LIVE_SEARCH_CACHE_MINUTES=30
LIVE_SEED_BUDGET=12
LIVE_SEARCH_MAX_CONCURRENCY=3
LIVE_PROVIDER_TIMEOUT_SECONDS=8
LIVE_SEARCH_DEADLINE_SECONDS=10
SHOWSTART_TIMEOUT_SECONDS=5
VERIFIED_OFFICIAL_TIMEOUT_SECONDS=6
ENABLE_VERIFIED_OFFICIAL_CONCERTS=true

# Experimental concert sources remain off unless explicitly enabled.
ENABLE_MAOYAN_CONCERTS=false
ENABLE_KKTIX_CONCERTS=false
ENABLE_SHOWSTART_CONCERTS=false
