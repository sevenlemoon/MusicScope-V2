# MusicScope V2 uses its own database and named Docker volume.
POSTGRES_DB=musicscope_v2
POSTGRES_USER=musicscope_v2
POSTGRES_PASSWORD=musicscope_v2_dev
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://musicscope_v2:musicscope_v2_dev@localhost:55432/musicscope_v2

API_HOST=0.0.0.0
API_PORT=8100
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8100
LOG_LEVEL=INFO

# Server-only AES-256-GCM key: URL-safe base64 for exactly 32 random bytes.
# Required before storing provider sessions. Never expose this as NEXT_PUBLIC_*.
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_VERSION=1

# R1 will select and configure the server-side NetEase API implementation.
NETEASE_API_BASE_URL=http://127.0.0.1:36531
NETEASE_REQUEST_TIMEOUT_SECONDS=10
NETEASE_PLAYLIST_PAGE_SIZE=50
NETEASE_SONG_BATCH_SIZE=200
NETEASE_SONG_CONCURRENCY=2
MUSICSCOPE_NETEASE_PORT=36531

# R0 creates only the storage/job contracts. No model is invoked yet.
AUDIO_STORAGE_DIR=storage/audio
SEPARATOR_EXECUTABLE=
SEPARATOR_MODEL=htdemucs

# Optional future concert adapters. No provider is configured in R0.
CONCERT_PROVIDER=none
TICKETMASTER_API_KEY=
